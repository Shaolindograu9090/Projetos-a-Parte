  pinMode(botao1, INPUT_PULLUP);
  pinMode(botao2, INPUT_PULLUP);
  pinMode(botao3, INPUT_PULLUP);

  Serial.begin(9600);
}

void tocarNota(int frequencia)
{
  frequencia = frequencia * pow(2, oitava);

  tone(buzzer, frequencia, 150);

  notasTocadas++;
  ultimaNota = frequencia;

  Serial.print("Nota: ");
  Serial.println(frequencia);
}

void loop()
{
  if (digitalRead(botao1) == LOW)
  {
    tocarNota(440);
    delay(180);
  }

  if (digitalRead(botao2) == LOW)
  {
    tocarNota(494);
    delay(180);
  }

  if (digitalRead(botao3) == LOW)
  {
    tocarNota(523);
    delay(180);
  }

  if (notasTocadas >= 10)
  {
    Serial.println("10 notas tocadas!");
    notasTocadas = 0;
  }

  delay(20);
}
